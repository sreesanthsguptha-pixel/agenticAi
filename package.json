{
  "name": "agentflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic AI Automation Platform (Agentflow_AI)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
